{
  "name": "powertimeline",
  "private": true,
  "version": "0.8.15",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:analyze": "tsc -b && vite build --mode analyze",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "optimize:images": "node scripts/optimize-images.mjs",
    "test": "playwright test",
    "test:prod": "playwright test tests/production/",
    "test:smoke": "playwright test tests/editor/01-foundation.smoke.spec.ts --project=desktop",
    "test:mobile": "playwright test --project=mobile tests/mobile/",
    "test:tablet": "playwright test --project=tablet",
    "test:responsive": "playwright test tests/responsive/",
    "test:desktop": "playwright test --project=desktop",
    "test:all-viewports": "playwright test",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:update-doc": "node scripts/update-tests-doc.js",
    "test:screens": "playwright test tests/seeding-screenshots.spec.ts",
    "test:clustered": "playwright test tests/clustered-count.spec.ts",
    "test:degradation": "playwright test tests/degradation-flow.spec.ts",
    "version:check": "node scripts/check-version.cjs",
    "version:sync": "node scripts/sync-version.cjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.1",
    "@mui/material": "^7.3.1",
    "@mui/x-date-pickers": "^8.11.3",
    "@types/react-window": "^1.8.8",
    "dayjs": "^1.11.18",
    "diff": "^8.0.2",
    "firebase": "^12.4.0",
    "firebase-admin": "^13.6.0",
    "js-yaml": "^4.1.1",
    "react": "^19.1.1",
    "react-diff-viewer-continued": "^3.4.0",
    "react-dom": "^19.1.1",
    "react-helmet-async": "^2.0.5",
    "react-joyride": "^2.9.3",
    "react-router-dom": "^7.9.4",
    "react-virtualized-auto-sizer": "^1.0.24",
    "react-window": "^1.8.10",
    "recharts": "^3.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.54.2",
    "@tailwindcss/cli": "^4.1.11",
    "@tailwindcss/postcss": "^4.1.11",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.0.15",
    "autoprefixer": "^10.4.21",
    "dotenv": "^17.2.3",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "jsdom": "^27.3.0",
    "lint-staged": "^16.1.6",
    "postcss": "^8.5.6",
    "rollup-plugin-analyzer": "^4.0.0",
    "sharp": "^0.34.4",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.20.6",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.0",
    "vite": "^7.1.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.0.15"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "node scripts/typecheck-lint-staged.mjs"
    ]
  }
}
